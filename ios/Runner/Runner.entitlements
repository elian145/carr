<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Do not add keychain-access-groups here. Sideloadly free-account IPAs break with
  that entitlement; Codemagic strips it if present. App Keychain items use the
  default access group (see TokenStore / docs/IOS_TESTING.md §8).
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:carr-5hrm.onrender.com</string>
		<string>applinks:carr-5hrm.onrender.com?mode=developer</string>
		<string>applinks:carzo.airbridge.io</string>
		<string>applinks:carzo.abr.ge</string>
	</array>
</dict>
</plist>
