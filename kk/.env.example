## kk backend example env (DO NOT commit real secrets)
APP_ENV=development

# REQUIRED in production
SECRET_KEY=REPLACE_ME
JWT_SECRET_KEY=REPLACE_ME
# Access JWT lifetime in minutes (default 30, clamped 15–60). Refresh tokens stay long-lived.
# JWT_ACCESS_TOKEN_MINUTES=30
# JWT_REFRESH_TOKEN_DAYS=30

# Database
DATABASE_URL=postgresql://user:pass@host:5432/car_listings

# Redis (REQUIRED in production — shared rate limits across Gunicorn workers)
# Also used for JWT blocklist coordination, Socket.IO multi-worker, Celery.
REDIS_URL=redis://localhost:6379/0
# Emergency only (not for store launch): allow per-process in-memory rate limits
# ALLOW_INMEMORY_RATE_LIMITS=1

# Socket.IO: query-string ?token= JWT is allowed in development/testing only.
# Set only for controlled non-prod experiments (Flutter uses Authorization header).
# ALLOW_SOCKET_QUERY_TOKEN=1

# Socket.IO multi-worker scaling
# Use Redis as a message queue so broadcasts work across Gunicorn workers.
# Defaults to REDIS_URL in production when unset.
SOCKETIO_MESSAGE_QUEUE=

# Celery (async jobs)
# Defaults to REDIS_URL when unset.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Logging / observability
# - LOG_JSON=true emits one JSON log line per request (recommended in production)
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID

# Monitoring (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Email
# Signup confirmation link: set PUBLIC_BASE_URL so the email uses https (e.g. https://api.yourdomain.com).
# If unset, the email will use carzo:// which only opens when the app is installed and the link is opened on that device.
# PUBLIC_BASE_URL=https://api.yourdomain.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_DEFAULT_SENDER=REPLACE_ME

# Firebase (push)
FIREBASE_SERVER_KEY=REPLACE_ME
FIREBASE_PROJECT_ID=REPLACE_ME

# Where uploaded listing photos/videos and profile images are stored on disk.
# REQUIRED on hosts with an ephemeral filesystem (Docker, Render, Heroku, etc.)
# unless Cloudflare R2 is fully configured (see below):
# mount a persistent volume and set this to an absolute path on that volume.
# Otherwise files disappear on redeploy/restart while DB rows still point at old URLs → HTTP 404.
# UPLOAD_FOLDER=/data/uploads
#
# Production refuse-to-boot unless R2 (with R2_PUBLIC_URL) or absolute UPLOAD_FOLDER is set.
# Emergency only (not for store launch):
# ALLOW_EPHEMERAL_UPLOADS=1

# Cloudflare R2 (recommended for production – object storage)
# When fully configured (including R2_PUBLIC_URL), listing PHOTOS and VIDEOS are stored in the
# bucket and the DB stores public HTTPS URLs (survive Render redeploys).
# Presigned PUT: POST /api/media/r2/sign-upload — use "asset":"image" (default) or "asset":"video".
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=REPLACE_ME
# R2_SECRET_ACCESS_KEY=REPLACE_ME
# R2_BUCKET_NAME=your-bucket
# Public base URL for objects (r2.dev subdomain or Custom Domain to the bucket)
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Trust & legal (mobile Settings / Help / store submission)
# PUBLIC_BASE_URL=https://your-api.onrender.com
# SUPPORT_EMAIL=support@yourdomain.com
# TERMS_URL=   # optional; default: {PUBLIC_BASE_URL}/terms
# PRIVACY_URL= # optional; default: {PUBLIC_BASE_URL}/privacy

# Moderation: new listings start as pending until admin sets status=active
# (default on when APP_ENV=production; set 0 to auto-publish)
# LISTING_REQUIRE_APPROVAL=1

# Force-update gates (also editable in admin Settings → Force update)
# MIN_APP_VERSION=1.0.1
# MIN_ANDROID_BUILD=4
# MIN_IOS_BUILD=4
# FORCE_UPDATE_MESSAGE=Please update CarNet to continue.
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.carzo.app
# IOS_STORE_URL=

# AI
# OPENAI_API_KEY / OPENAI_MODEL — used by POST /api/suggest-car-specs (YMMT fallback).
# Car image vision analysis (/api/analyze-car-image) is disabled until a real model ships.
# Never enable the hardcoded placeholder in production.
# ALLOW_PLACEHOLDER_CAR_ANALYSIS=0

# Auth rate limits (optional overrides)
# RATE_LIMIT_SEND_OTP=3
# RATE_LIMIT_SIGNUP=5
