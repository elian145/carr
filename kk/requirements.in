# Direct production dependencies (F-15). EDIT THIS FILE, then regenerate the
# fully pinned, hash-locked kk/requirements.txt (what Render/Docker/CI install):
#
#   uv pip compile kk/requirements.in --universal --generate-hashes \
#       --python-version 3.11 -o kk/requirements.txt
#
# (--universal resolves for every OS and for Python >=3.11 so the same lock
# works on Render's 3.11 and the Docker/CI 3.12 images.)
