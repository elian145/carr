{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carnet.model_union/2",
  "title": "CarNet generated model union (layer 2) for one Brand+Model",
  "description": "Generated from the evidence file. 'verified' holds only VERIFIED unique normalized values: >=1 tier 1-3 record whose source integrity is FULL_TEXT_VERIFIED or PDF_VERIFIED, whose quote was found in the preserved snapshot (sha256-checked), not demoted by a tier 1-3 disagreement. 'union' is an identical legacy alias of 'verified'. Tier 1-3 values backed only by snippets / unavailable / unpreserved retrievals are in 'needs_source_retrieval'. Values supported only by tier 4-5 (or demoted by a conflict) are in 'provisional_only'. The three sections are disjoint. Conflicts are preserved, never resolved. Source detail stays in 'details' (record_ids) and in the evidence file.",
  "type": "object",
  "required": ["schema_version", "brand", "model", "generated_from", "vocabulary_version", "production_policy", "verified", "union", "provisional_only", "needs_source_retrieval", "details", "engines", "conflicts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "carnet.model_union/2" },
    "vocabulary_version": { "const": "carnet.vocabulary/1" },
    "production_policy": {
      "type": "object",
      "required": ["production_bound_section", "verified_requires", "includes_provisional", "includes_needs_source_retrieval", "unresolved_conflicts", "conflicts_block_promotion_until_reviewed", "review_status"],
      "properties": {
        "production_bound_section": { "const": "verified" },
        "verified_requires": { "type": "string" },
        "includes_provisional": { "const": false },
        "includes_needs_source_retrieval": { "const": false },
        "needs_source_retrieval_values_live_in": { "type": "string" },
        "provisional_values_live_in": { "type": "string" },
        "unresolved_conflicts": { "type": "integer", "minimum": 0 },
        "conflicts_block_promotion_until_reviewed": { "type": "boolean" },
        "review_status": { "enum": ["UNREVIEWED", "REVIEWED"] }
      }
    },
    "brand": { "type": "string" },
    "model": { "type": "string" },
    "generated_from": {
      "type": "object",
      "required": ["evidence_file", "researched_at", "record_count", "source_count", "records_by_source_tier", "records_by_integrity_state", "sources_by_integrity_state", "records_passing_integrity_test"],
      "properties": {
        "records_by_integrity_state": { "type": "object", "required": ["FULL_TEXT_VERIFIED", "PDF_VERIFIED", "SNIPPET_ONLY", "UNAVAILABLE", "RETRIEVED_UNVERIFIABLE"], "additionalProperties": { "type": "integer", "minimum": 0 } },
        "sources_by_integrity_state": { "type": "object", "required": ["FULL_TEXT_VERIFIED", "PDF_VERIFIED", "SNIPPET_ONLY", "UNAVAILABLE", "RETRIEVED_UNVERIFIABLE"], "additionalProperties": { "type": "integer", "minimum": 0 } },
        "records_passing_integrity_test": { "type": "integer", "minimum": 0 },
        "evidence_file": { "type": "string" },
        "researched_at": { "type": "string" },
        "record_count": { "type": "integer" },
        "source_count": { "type": "integer" },
        "records_by_source_tier": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "research_coverage": { "type": "array", "items": { "type": "string" } },
    "verified": { "$ref": "#/properties/union" },
    "union": {
      "type": "object",
      "description": "legacy alias of 'verified' (identical content)",
      "required": ["trims", "engine_sizes", "cylinders", "fuel_types", "transmissions", "transmission_variants", "transmission_gears", "drivetrains", "body_types", "seats", "doors"],
      "additionalProperties": false,
      "properties": {
        "trims": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "engine_sizes": { "type": "array", "items": { "type": "string", "pattern": "^\\d+\\.\\dL$" }, "uniqueItems": true },
        "cylinders": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
        "fuel_types": { "type": "array", "items": { "enum": ["Petrol", "Diesel", "Electric", "Hybrid", "Plug-in Hybrid"] }, "uniqueItems": true },
        "transmissions": { "type": "array", "items": { "enum": ["Automatic", "Manual"] }, "uniqueItems": true, "description": "transmission FAMILY" },
        "transmission_variants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "description": "canonical variants (Conventional automatic, CVT, e-CVT, DCT, AMT) and the source's own named systems" },
        "transmission_gears": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
        "drivetrains": { "type": "array", "items": { "enum": ["FWD", "RWD", "AWD", "4WD"] }, "uniqueItems": true },
        "body_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "seats": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
        "doors": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true }
      }
    },
    "provisional_only": { "type": "object", "description": "Same keys as 'verified'; tier 4-5 (or conflict-demoted) values, NOT verified.", "additionalProperties": { "type": "array" } },
    "needs_source_retrieval": { "type": "object", "description": "Same keys as 'verified'; tier 1-3 values whose source content was not validated (SNIPPET_ONLY / UNAVAILABLE / RETRIEVED_UNVERIFIABLE). NOT verified.", "required": ["trims", "engine_sizes", "cylinders", "fuel_types", "transmissions", "transmission_variants", "transmission_gears", "drivetrains", "body_types", "seats", "doors"], "additionalProperties": { "type": "array" } },
    "empty_dimensions": { "type": "array", "items": { "type": "string" }, "description": "Dimensions with no value at all (unknown stays unknown)." },
    "engines": {
      "type": "array",
      "description": "Per engine-size roll-up of the spec figures seen in evidence (kept per record so disagreements stay visible).",
      "items": {
        "type": "object",
        "properties": {
          "engine_size_label": { "type": "string" },
          "displacement_cc": { "type": "array", "items": { "type": "integer" } },
          "cylinders": { "type": "array", "items": { "type": "integer" } },
          "fuel_types": { "type": "array", "items": { "type": "string" } },
          "aspirations": { "type": "array", "items": { "type": "string" } },
          "power_hp": { "type": "array", "items": { "type": "object" } },
          "torque_nm": { "type": "array", "items": { "type": "object" } },
          "best_tier": { "type": "integer" },
          "record_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "details": {
      "type": "object",
      "description": "Per dimension, per value: status, supporting record_ids/source_ids, best tier, markets, year span, conflict flag.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["value", "status", "best_tier", "record_ids", "source_ids"],
          "properties": {
            "value": {},
            "status": { "enum": ["VERIFIED", "NEEDS_SOURCE_RETRIEVAL", "PROVISIONAL"] },
            "integrity_states": { "type": "array", "items": { "type": "string" }, "description": "integrity states of every supporting record's source" },
            "validated_record_ids": { "type": "array", "items": { "type": "string" }, "description": "supporting records whose quote was found in the preserved snapshot" },
            "best_tier": { "type": "integer" },
            "max_confidence": { "type": "number" },
            "support_count": { "type": "integer" },
            "record_ids": { "type": "array", "items": { "type": "string" } },
            "source_ids": { "type": "array", "items": { "type": "string" } },
            "markets": { "type": "array", "items": { "type": "string" } },
            "years": { "type": ["array", "null"], "items": { "type": "integer" } },
            "in_conflict": { "type": "boolean" }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "field", "engine_group", "severity", "values", "resolution"],
        "properties": {
          "conflict_id": { "type": "string" },
          "field": { "type": "string" },
          "engine_group": { "type": "string" },
          "severity": { "enum": ["definite", "possible_year_unspecified"] },
          "values": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["record_id", "value", "source_id", "source_tier"] } },
          "resolution": { "type": "string" }
        }
      }
    }
  }
}
