{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CarNet model matching manual review queue",
  "type": "object",
  "required": ["schema_version", "total_rows", "unique_entries", "rows_per_category", "entries"],
  "properties": {
    "schema_version": {"const": "carnet.model_matching_review_queue/1"},
    "total_rows": {"type": "integer", "minimum": 0},
    "unique_entries": {"type": "integer", "minimum": 0},
    "rows_per_category": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "brand", "model", "qualifier", "rows", "examples"],
        "properties": {
          "category": {"type": "string"},
          "brand": {"type": "string"},
          "model": {"type": "string"},
          "qualifier": {"type": "string"},
          "rows": {"type": "integer", "minimum": 1},
          "examples": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}}
        }
      }
    }
  }
}
