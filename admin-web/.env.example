# Flask API base URL (no trailing slash, no /api suffix).
# Used by Next.js rewrites (/backend-api → this host) and public listing links.
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Production (Render): point at your API service, e.g.
# NEXT_PUBLIC_API_BASE=https://carr-5hrm.onrender.com

# Optional override for the proxy target only (defaults to NEXT_PUBLIC_API_BASE).
# API_PROXY_TARGET=https://carr-5hrm.onrender.com

# --- Admin session verification (pick ONE; production requires one of them) ---
# PREFERRED (F-19): PUBLIC key (PEM, EC P-256) matching the API's
# ADMIN_JWT_PRIVATE_KEY. Verify-only: a compromised admin-web can NOT mint any
# token with it. Newlines may be written as \n.
# ADMIN_JWT_PUBLIC_KEY=
#
# Admin-signed tokens must carry iss/aud. Defaults (carnet-api / carnet-admin-web)
# match the API; only set these if the API sets ADMIN_JWT_ISSUER/ADMIN_JWT_AUDIENCE
# to something else (both services must agree, otherwise every session is rejected).
# ADMIN_JWT_ISSUER=
# ADMIN_JWT_AUDIENCE=
#
# LEGACY: same JWT_SECRET_KEY as the Flask API. This shared HS256 secret lets
# anyone who compromises admin-web forge tokens for ANY user - remove it once
# ADMIN_JWT_PUBLIC_KEY is in use (docs/F19_ADMIN_TOKEN_SEPARATION.md).
# JWT_SECRET_KEY=

# Optional CSRF allow-list: comma-separated exact origins allowed to send
# POST/PUT/PATCH/DELETE to /backend-api and /api/admin-session. Unset = the
# request's own origin (host from X-Forwarded-Host/Host), which is right for
# Render and local dev. Set it when the public origin differs from the host the
# Node process sees (custom proxy/domain).
# ADMIN_ALLOWED_ORIGINS=https://admin.example.com

# Local development WITHOUT any key/secret (F-32): by default the edge gate now rejects
# every session (fails closed). To accept unsigned admin claims locally (the Flask
# API still rejects them) set the flag below. It is ignored in production.
# ADMIN_ALLOW_UNSIGNED_DEV=1
#
# Session cookies are always 'Secure' in production. Only for plain-HTTP
# production-mode runs (e.g. 'next start' on localhost) opt out explicitly:
# ADMIN_COOKIE_ALLOW_HTTP=1
