# Flask API base URL (no trailing slash, no /api suffix).
# Used by Next.js rewrites (/backend-api → this host) and public listing links.
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Optional override for the proxy target only (defaults to NEXT_PUBLIC_API_BASE).
# API_PROXY_TARGET=https://carr-5hrm.onrender.com

# Same JWT_SECRET_KEY as the Flask API. Required in production so middleware can
# verify the httpOnly admin session cookie (carzo_admin_jwt).
# JWT_SECRET_KEY=
